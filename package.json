{
  "name": "road-crash-locations",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive map for exploring Queensland road-traffic crash locations in the Brisbane area.",
  "license": "MIT",
  "author": "tuokaikyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuokaikyle/road-crash-locations.git"
  },
  "bugs": {
    "url": "https://github.com/tuokaikyle/road-crash-locations/issues"
  },
  "keywords": [
    "brisbane",
    "queensland",
    "road-safety",
    "crash-data",
    "open-data",
    "maplibre",
    "react",
    "vite"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.41.0",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-map-gl": "^8.1.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.21.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
